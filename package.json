{
  "name": "rl-overlay-studio",
  "version": "2.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others --names OVL,CTRL,APP \"vite --config vite.overlay.config.mjs\" \"vite --config vite.control.config.mjs\" \"node electron/wait-and-launch.mjs\"",
    "dev:overlay": "vite --config vite.overlay.config.mjs",
    "build:overlay": "vite build --config vite.overlay.config.mjs",
    "build:control": "vite build --config vite.control.config.mjs",
    "build": "npm run build:overlay && npm run build:control",
    "dist": "npm run build && electron-builder",
    "start": "cross-env ELECTRON_RUN_AS_NODE= node node_modules/electron/cli.js ."
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "obs-websocket-js": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.rl.overlay-studio",
    "productName": "RL Overlay Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "public/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
